    "import sqlite3\n",
    "\n",
    "conn = sqlite3.connect(\"../data/vivino.db\")\n",
    "cursor = conn.cursor()  # not cursos() 😄\n",
    "\n",
    "with open(\"../queries/test_queries.sql\", \"r\") as f:\n",
    "    query = f.read()\n",
    "\n",
    "cursor.execute(query)\n",
    "print(cursor.fetchall())"
   ]
  }
